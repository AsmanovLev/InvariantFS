# build artifacts
# bin/ holds only make output; the single tracked file is the vendored
# static busybox consumed by tools/mkinitramfs.sh (not built by this repo).
bin/*
!bin/busybox-static
build/
*.o
*.a
*.so
*.d
*.obj
*.ivpack

# volume images (never commit)
*.img
vm/

# release artifacts (make release)
dist/

# runtime logs
logs/
.ci-tools/

# external clone with own .git
tools/7-Zip-zstd/

# empty by design
downloads/
__pycache__/
*.pyc

# generated docs bundle + playwright scratch
INVARIFS-DOCS.md
.playwright-mcp/

# WP22b flakey soak failure artifacts (backing images + logs)
tools/flakey/artifacts/

# codecpack helper binaries: rebuilt from the .c next to them by
# tools/test-<pack>.sh (cc -std=c11 ...) on every e2e run
tools/codecpacks/*/bin/

# generated video artifacts (regenerable: video/gen-overview.py + build.sh)
video/frames/
video/*.mp4
video/filter.txt

# local staging/VM trees (never track)
var/
*.d

# doxygen output (generated; make docs)
impl_docs/doxygen/

# LSP compilation database and editor configs
compile_commands.json
.clangd
