# qcow2 codecpack (WP16a/WP16b): QEMU qcow2 disk image decomposition.
#
# qcow2 v2/v3 images only, no backing file, no internal snapshots, no
# encryption, refcount_bits=16, no unknown incompatible feature bits;
# compressed clusters are decoded into diskimg and retained in the recipe;
# exact zlib reproduction tries bundled stock zlib 1.3.1 and the system zlib
# backend, recording the matching encoder in the deflate reproduction result.
# Two members: idx 1 "diskimg" is the full virtual-size guest disk with
# unallocated regions zero-filled, for nested rawdisk/ext4fs decomposition;
# idx 2 "rankimg" is the allocated-cluster stream referenced by Q2R/MRMP
# for bit-exact original-image reads and rebuild. The recipe is every other
# byte of the file verbatim (header + extensions, L1/L2 tables, refcount
# table + blocks, free-cluster junk, trailing junk, in file order) prefixed
# by a small pack-owned layout table, so rebuild is bit-exact by
# construction, junk-in-a-hole included. See qcow2.c for the full format
# documentation + the validation list.
#
# The sniff keys on the u32 signature "QFI\xFB" at offset 0. The map command
# makes the pack SEEKABLE (CAP_SEEK): reads splice from the recipe + the
# member sibling and never exec the pack.
#
# The helper is a compiled C11 binary (libc only): bin/qcow2, built from the
# in-pack qcow2.c (tools/test-qcow2.sh compiles it; a missing binary = probe
# fails = files wait RAW, the standard tools-absent convention). argv0 is the
# pack-dir-relative "bin/qcow2": the FS resolves a relative argv0 containing
# '/' against the pack dir both at probe and at exec time (a "{pack}/..."
# argv0 would NOT be substituted by probe() — the pack would never register
# as available).
name = qcow2
type = container
algo = 22
codec_id = 22
pack_version = 3
version = 1
min_read = 1
generation = 2
family = container
category = primary
provides = container
replaces =
conflicts =
priority = 100
caps = container|external
dec_mem = 0
sniff.offset = 0
sniff.magic = 514649FB
sniff.ext = qcow2
enumerate = bin/qcow2 enumerate {in} {out}
extract = bin/qcow2 extract {in} {idx} {out}
strip = bin/qcow2 strip {in} {out}
rebuild = bin/qcow2 rebuild {recipe} {dir} {out}
map = bin/qcow2 map {recipe} {out}
# the map is rendered from the RECIPE (Q2R3 parameters live there), and
# decomp_gen opts into the FS-owned generation stamp: a stored layout older
# than the pack generation is re-derived from the reconstructed stream.
decomp_gen = 1
estimate = bin/qcow2 estimate {in}
